# Python STT Pro 환경설정 예시
# 이 파일을 .env 로 복사해서 사용하세요:  cp .env.example .env
# (.env 는 .gitignore 에 의해 git 에 올라가지 않습니다)

# ── 로컬 LMStudio 번역 백엔드 (무료·오프라인) ──────────────────
# LMStudio 에서 모델을 로드하고 1234 포트 'Local Server' 를 켠 뒤 사용.
LMSTUDIO_MODEL=qwen/qwen3.6-27b
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ── OpenAI 클라우드 번역 백엔드 (선택) ────────────────────────
# UI 에서 "OpenAI" 엔진을 고를 때만 필요합니다.
# OPENAI_API_KEY=sk-...
# OPENAI_TRANSLATE_MODEL=gpt-4o
# OPENAI_BASE_URL=

# ── 화자 분리 / AI 요약 ──────────────────────────────────────
# 화자 분리(pyannote)용 HuggingFace Read 토큰 (README '화자 분리 설정' 참고)
# HF_TOKEN=hf_...
# AI 요약 모델 (기본 gpt-4o-mini; OPENAI_API_KEY 필요)
# OPENAI_SUMMARY_MODEL=gpt-4o-mini
# 화자 분리 장치 강제 지정 (기본 자동: cuda > mps > cpu)
# DIARIZE_DEVICE=cpu

# ── 결과물 자동 저장 ─────────────────────────────────────────
# 전사·번역 완료 시 ~/Downloads 로 자동 복사 (기본 켜짐). 끄려면 0.
# SAVE_TO_DOWNLOADS=1
# 저장 루트 변경 (기본 ~/Downloads). 로컬 폴더 배치는 이 아래에
# 2025년_9월_고1 식 폴더로 자동 분류됩니다.
# STT_DOWNLOADS_DIR=

# ── 소스 폴더 연결 끊김 대응 ─────────────────────────────────
# 배치 도중 NAS/공유 폴더 연결이 끊기면 최대 N분간 재연결을 기다렸다가
# 이어서 전사합니다 (기본 10분). 0이면 즉시 중단.
# STT_RECONNECT_WAIT_MINUTES=10
# 자동 재마운트 주소(선택). 설정하면 대기 중 1분마다 재마운트를 시도합니다.
#   macOS:   smb://서버주소/공유이름   (키체인에 저장된 계정 사용)
#   Windows: \\서버주소\공유이름
# STT_REMOUNT_URL=smb://예시서버/studycode

# ── 보관 기간 ────────────────────────────────────────────────
# UPLOAD_RETENTION_DAYS=7
# OUTPUT_RETENTION_DAYS=30
